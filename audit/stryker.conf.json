{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "plugins": ["@stryker-mutator/jest-runner"],
  "jest": { "configFile": "jest.config.js", "enableFindRelatedTests": true },
  "coverageAnalysis": "perTest",
  "mutate": [
    "domains/academic/logic.ts",
    "domains/calendar/dayRules.ts",
    "core/db/backupValidation.ts",
    "core/fs/names.ts",
    "domains/calendar/exceptions.ts"
  ],
  "tempDirName": "audit/.stryker-tmp",
  "ignorePatterns": ["audit/mutation", "audit/.stryker-tmp", ".git"],
  "reporters": ["json", "clear-text", "progress-append-only"],
  "jsonReporter": { "fileName": "audit/mutation/mutation-report.json" },
  "concurrency": 4,
  "timeoutMS": 60000,
  "cleanTempDir": true
}
